# --- Multi-Provider LLM Keys ---------------------------------------
# Google Gemini (Default)
GEMINI_API_KEY=

# Anthropic Claude (e.g. Claude 3.7 Sonnet, Claude 3.5 Sonnet, Haiku)
ANTHROPIC_API_KEY=

# OpenAI (e.g. GPT-4o, GPT-4o-mini, o3-mini)
OPENAI_API_KEY=

# DeepSeek (e.g. DeepSeek-V3, DeepSeek-R1)
DEEPSEEK_API_KEY=

# Groq (e.g. Llama 3.3 70B, DeepSeek R1 Distill)
GROQ_API_KEY=

# Active default provider: gemini | claude | openai | deepseek | groq
ACTIVE_LLM_PROVIDER=gemini
ACTIVE_LLM_MODEL=gemini-3.8-flash

# --- Evolution engine ----------------------------------------------------
# Start the autonomous loop on server boot. Leave false to drive it manually
# from the dashboard until you're happy with the spend.
EVOLUTION_AUTOSTART=false

# Seconds between ticks (default 90000ms).
EVOLUTION_TICK_MS=90000

# Cost ceiling. The engine idles instead of spending past this.
EVOLUTION_MAX_CALLS_PER_HOUR=240
EVOLUTION_MAX_CONCURRENCY=3

# Throughput. Keep WIP low relative to evals per tick or nothing gets promoted.
EVOLUTION_MAX_WIP=12

# Retired skills kept beyond those still needed as lineage ancestors.
EVOLUTION_RETIRED_RETENTION=60
EVOLUTION_EVALS_PER_TICK=2

EVOLUTION_MAX_POPULATION=48

# How mutation treats the parent.
#   branching — child added as a new skill, parent survives, both compete.
#               Produces mutation edges in the lineage graph. Explores more,
#               fills the evaluation pipeline faster.
#   in-place  — genome overwritten. One node per lineage, no ancestry edge.
EVOLUTION_MUTATION_STRATEGY=branching
EVOLUTION_CHAMPION_THRESHOLD=95

# Models. Executor runs the skill, judge grades it, architect writes genomes.
# Executor and judge are different generations on purpose: a model grading its
# own family shares its blind spots.
# Do NOT use gemini-2.5-* — restricted to projects with prior usage, retiring
# October 2026. Current stable Flash models: 3.8, 3.7, 3.6.
EVOLUTION_EXECUTOR_MODEL=gemini-3.6-flash
EVOLUTION_JUDGE_MODEL=gemini-3.8-flash
EVOLUTION_ARCHITECT_MODEL=gemini-3.8-flash

# Per-request timeout; a hung call would otherwise hold a concurrency slot.
EVOLUTION_REQUEST_TIMEOUT_MS=90000

# --- Access -----------------------------------------------------------------
# Operator token for POST /api/evolution/* from anywhere but localhost.
# 16+ characters. Leave unset to allow localhost only.
EVOLUTION_API_TOKEN=

# Set true only if you have put your own authentication in front of the server.
EVOLUTION_ALLOW_REMOTE=false

# Set true behind a reverse proxy so rate limits use the real client address.
TRUST_PROXY=false
